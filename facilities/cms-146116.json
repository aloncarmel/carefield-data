able.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-k0353":{"code":"K-0353","title":"Inspect, test, and maintain automatic sprinkler systems.","category":"Smoke Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-f0686":{"code":"F-0686","title":"Provide appropriate pressure ulcer care and prevent new ulcers from developing.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0690":{"code":"F-0690","title":"Provide appropriate care for residents who are continent or incontinent of bowel/bladder, appropriate catheter care,  and appropriate care  to prevent urinary tract infections.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0698":{"code":"F-0698","title":"Provide safe, appropriate dialysis care/services for a resident who requires such services.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"}},"penalties":[{"id":"cms-146116-pen-d20250806","type":"payment_denial","type_label":"Denial of payment for new admissions","date":"2025-08-06","denial_start":"2025-09-04","denial_days":27,"evidence_class":"VERIFIED","source_record_id":"146116|Payment Denial|2025-09-04"},{"id":"cms-146116-pen-f134296","type":"fine","type_label":"Civil money penalty (fine)","date":"2025-08-06","amount":118080,"fine_id":"134296","evidence_class":"VERIFIED","source_record_id":"146116|Fine|134296"},{"id":"cms-146116-pen-d20240815","type":"payment_denial","type_label":"Denial of payment for new admissions","date":"2024-08-15","denial_start":"2024-09-14","denial_days":9,"evidence_class":"VERIFIED","source_record_id":"146116|Payment Denial|2024-09-14"},{"id":"cms-146116-pen-f69988","type":"fine","type_label":"Civil money penalty (fine)","date":"2024-08-15","amount":27983,"fine_id":"69988","