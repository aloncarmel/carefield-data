y"},"cms-k0363":{"code":"K-0363","title":"Install corridor and hallway doors that block smoke.","category":"Smoke Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-f0943":{"code":"F-0943","title":"Give their staff education on dementia care, and what abuse, neglect, and exploitation are; and how to report abuse, neglect, and exploitation.","category":"Freedom from Abuse, Neglect, and Exploitation Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0610":{"code":"F-0610","title":"Respond appropriately to all alleged violations.","category":"Freedom from Abuse, Neglect, and Exploitation Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0688":{"code":"F-0688","title":"Provide appropriate care for a resident to maintain and/or improve range of motion (ROM), limited ROM and/or mobility, unless a decline is for a medical reason.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0847":{"code":"F-0847","title":"Inform resident or representatives choice to enter into binding arbitration agreement and right to refuse.","category":"Administration Deficiencies","concept":"administration","concept_label":"Administration & records"},"cms-f0758":{"code":"F-0758","title":"Implement gradual dose reductions(GDR) and non-pharmacological interventions, unless contraindicated, prior to initiating or instead of continuing psychotropic medication; and PRN orders for psychotropic medications are only used when the medication is necessary and PRN use is limited.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0602":{"code":"F-0602","title":"Protect each resident from the wrongful use of the resident's belongings or money.","category":"Freedom from Abuse, Neglect, and Exploitation Deficiencies","concept":"resident_rig