inical care"},"cms-f0842":{"code":"F-0842","title":"Safeguard resident-identifiable information and/or maintain medical records on each resident that are in accordance with accepted professional standards.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0600":{"code":"F-0600","title":"Protect each resident from all types of abuse such as physical, mental, sexual abuse, physical punishment, and neglect by anybody.","category":"Freedom from Abuse, Neglect, and Exploitation Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0607":{"code":"F-0607","title":"Develop and implement policies and procedures to prevent abuse, neglect, and theft.","category":"Freedom from Abuse, Neglect, and Exploitation Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0585":{"code":"F-0585","title":"Honor the resident's right to voice grievances without discrimination or reprisal and the facility must establish a grievance policy and make prompt efforts to resolve grievances.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0609":{"code":"F-0609","title":"Timely report suspected abuse, neglect, or theft and report the results of the investigation to proper authorities.","category":"Freedom from Abuse, Neglect, and Exploitation Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0727":{"code":"F-0727","title":"Have a registered nurse on duty 8 hours a day; and  select a registered nurse to be the director of nurses on a full time basis.","category":"Nursing and Physician Services Deficiencies","concept":"staffing","concept_label":"Staffing & supervision"},"cms-f0558":{"code":"F-0558","title":"Reasonably accommodate the needs and preferences of each resident.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0605":{"code":"F-0605","title":"Prevent the use of unnecessary psychotropic medications or use medications that may restrain a resident's ability to function.","category":"Freedom from Abuse, Neglect, and Exploitation Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0656":{"code":"F-0656","title":"Develop and implement a complete care plan that meets all the resident's needs, with timetables and actions that can be measured.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0692":{"code":"F-0692","title":"Provide enough food/fluids to maintain a resident's health.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0757":{"code":"F-0757","title":"Ensure each resident’s drug regimen must be free from unnecessary drugs.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0791":{"code":"F-0791","title":"Provide or obtain dental services for each resident.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0880":{"code":"F-0880","title":"Provide and implement an infection prevention and control program.","category":"Infection Control Deficiencies","concept":"infection_prevention","concept_label":"Infection prevention"},"cms-f0684":{"code":"F-0684","title":"Provide appropriate treatment and care according to orders, resident’s preferences and goals.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0584":{"code":"F-0584","title":"Honor the resident's right to a safe, clean, comfortable and homelike environment, including but not limited to receiving treatment and supports for daily living safely.",