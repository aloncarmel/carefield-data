inical care"},"cms-f0695":{"code":"F-0695","title":"Provide safe and appropriate respiratory care for a resident when needed.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0758":{"code":"F-0758","title":"Implement gradual dose reductions(GDR) and non-pharmacological interventions, unless contraindicated, prior to initiating or instead of continuing psychotropic medication; and PRN orders for psychotropic medications are only used when the medication is necessary and PRN use is limited.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0609":{"code":"F-0609","title":"Timely report suspected abuse, neglect, or theft and report the results of the investigation to proper authorities.","category":"Freedom from Abuse, Neglect, and Exploitation Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0660":{"code":"F-0660","title":"Plan the resident's discharge to meet the resident's goals and needs.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-e0039":{"code":"E-0039","title":"Conduct testing and exercise requirements.","category":"Emergency Preparedness Deficiencies","concept":"emergency_preparedness","concept_label":"Emergency preparedness"},"cms-k0345":{"code":"K-0345","title":"Have approved installation, maintenance and testing program for fire alarm systems.","category":"Smoke Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-k0914":{"code":"K-0914","title":"Ensure receptacles at patient bed locations and where general anesthesia is administered, are tested after initial installation, replacement or servicing.","category":"Gas, Vacuum, and Electrical Systems Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-f0732"