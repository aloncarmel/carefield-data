rievances.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0686":{"code":"F-0686","title":"Provide appropriate pressure ulcer care and prevent new ulcers from developing.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0690":{"code":"F-0690","title":"Provide appropriate care for residents who are continent or incontinent of bowel/bladder, appropriate catheter care,  and appropriate care  to prevent urinary tract infections.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0838":{"code":"F-0838","title":"Conduct and document a facility-wide assessment to determine what resources are necessary to care for residents competently during both day-to-day operations (including nights and weekends) and emergencies.","category":"Administration Deficiencies","concept":"administration","concept_label":"Administration & records"},"cms-k0211":{"code":"K-0211","title":"Keep aisles, corridors, and exits free of obstruction in case of emergency.","category":"Egress Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-k0915":{"code":"K-0915","title":"Have proper power supply for life support equipment.","category":"Gas, Vacuum, and Electrical Systems Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-f0584":{"code":"F-0584","title":"Honor the resident's right to a safe, clean, comfortable and homelike environment, including but not limited to receiving treatment and supports for daily living safely.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0882":{"code":"F-0882","title":"Designate a qualified infection preventionist to be responsible for the infection prevent and control program in the nursi