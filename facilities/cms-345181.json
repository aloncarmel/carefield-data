00":{"code":"F-0700","title":"Try different approaches before using a bed rail.  If a bed rail is needed, the facility must (1) assess a resident for safety risk; (2) review these risks and benefits with the resident/representative; (3) get informed consent; and (4) Correctly install and maintain the bed rail.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0880":{"code":"F-0880","title":"Provide and implement an infection prevention and control program.","category":"Infection Control Deficiencies","concept":"infection_prevention","concept_label":"Infection prevention"},"cms-f0658":{"code":"F-0658","title":"Ensure services provided by the nursing facility meet professional standards of quality.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0770":{"code":"F-0770","title":"Provide timely, quality laboratory services/tests to meet the needs of residents.","category":"Administration Deficiencies","concept":"administration","concept_label":"Administration & records"},"cms-k0161":{"code":"K-0161","title":"Use approved construction type or materials.","category":"Construction Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-k0345":{"code":"K-0345","title":"Have approved installation, maintenance and testing program for fire alarm systems.","category":"Smoke Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-k0351":{"code":"K-0351","title":"Install an approved automatic sprinkler system.","category":"Smoke Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-k0521":{"code":"K-0521","title":"Ensure heating and ventilation systems that have been properly installed according to the manufacturer's instructions.","category":"Services Deficiencies","concept":"environment_life_safety","