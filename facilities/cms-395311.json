":"Miscellaneous Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-k0741":{"code":"K-0741","title":"Have posted \"No-smoking\" signs in areas where smoking is not permitted or ashtrays provided where smoking was allowed.","category":"Miscellaneous Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-k0911":{"code":"K-0911","title":"Meet requirements for the installation and maintenance of electrical systems.","category":"Gas, Vacuum, and Electrical Systems Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-k0918":{"code":"K-0918","title":"Have generator or other power source capable of supplying service within 10 seconds.","category":"Gas, Vacuum, and Electrical Systems Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-e0036":{"code":"E-0036","title":"Establish emergency prep training and testing.","category":"Emergency Preparedness Deficiencies","concept":"emergency_preparedness","concept_label":"Emergency preparedness"},"cms-e0037":{"code":"E-0037","title":"Establish staff and initial training requirements.","category":"Emergency Preparedness Deficiencies","concept":"emergency_preparedness","concept_label":"Emergency preparedness"},"cms-f0689":{"code":"F-0689","title":"Ensure that a nursing home area is free from accident hazards and provides adequate supervision to prevent accidents.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0559":{"code":"F-0559","title":"Honor the resident's right to share a room with spouse or roommate of choice and receive written notice before a change is made.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0636":{"code":"F-0636","title":"Assess the resident completely in a timely manner  when first admitted, and then periodically, at least every 12 months.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0657":{"code":"F-0657","title":"Develop the complete care plan within 7 days of the comprehensive assessment; and prepared, reviewed, and revised by a team of health professionals.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0684":{"code":"F-0684","title":"Provide appropriate treatment and care according to orders, resident’s preferences and goals.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0698":{"code":"F-0698","title":"Provide safe, appropriate dialysis care/services for a resident who requires such services.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0813":{"code":"F-0813","title":"Have a policy regarding use and storage of foods brought to residents by family and other visitors.","category":"Nutrition and Dietary Deficiencies","concept":"food_nutrition","concept_label":"Food, nutrition & hydration"},"cms-f0880":{"code":"F-0880","title":"Provide and implement an infection prevention and control program.","category":"Infection Control Deficiencies","concept":"infection_prevention","concept_label":"Infection prevention"},"cms-f0919":{"code":"F-0919","title":"Make sure that a working call system is available in each resident's  bathroom and bathing area.","category":"Environmental Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-k0351":{"code":"K-0351","title":"Install an approved automatic sprinkler system.","category":"Smoke Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-k0321":{"code":"K-0321","title":"Ensure that special areas are constructed so that walls can resist fire for one hour or have an approved fire extinguishing system.","category":"Smoke Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-k0374":{"code":"K-0374","title":"Install smoke barrier doors that can resist smoke for at least 20 minutes.","category":"Smoke Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-k0923":{"code":"K-0923","title":"Have proper medical gas storage and administration areas.","category":"Gas, Vacuum, and Electrical Systems Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-f0679":{"code":"F-0679","title":"Provide activities to meet all resident's needs.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0600":{"code":"F-0600","title":"Protect each resident from all types of abuse such as physical, mental, sexual abuse, physical punishment, and neglect by anybody.","category":"Freedom from Abuse, Neglect, and Exploitation Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0655":{"code":"F-0655","title":"Create and put into place a plan for meeting the resident's most immediate needs within 48 hours of being admitted","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0658":{"code":"F-0658","title":"Ensure services provided by the nursing facility meet professional standards of quality.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0677":{"code":"F-0677","title":"Provide care and assistance to perform activities of daily living for any resident who is unable.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0690":{"code":"F-0690","ti