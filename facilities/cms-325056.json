ical care"},"cms-f0695":{"code":"F-0695","title":"Provide safe and appropriate respiratory care for a resident when needed.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0697":{"code":"F-0697","title":"Provide safe, appropriate pain management for a resident who requires such services.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0842":{"code":"F-0842","title":"Safeguard resident-identifiable information and/or maintain medical records on each resident that are in accordance with accepted professional standards.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0686":{"code":"F-0686","title":"Provide appropriate pressure ulcer care and prevent new ulcers from developing.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0580":{"code":"F-0580","title":"Immediately tell the resident, the resident's doctor, and a family member of situations (injury/decline/room, etc.)  that affect the resident.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0761":{"code":"F-0761","title":"Ensure drugs and biologicals used in the facility are labeled in accordance with currently accepted professional principles; and all drugs and biologicals must be stored in locked compartments, separately locked, compartments for controlled drugs.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0812":{"code":"F-0812","title":"Procure food from sources approved or considered satisfactory and store, prepare, distribute and serve food in accordance with professional standards.","category":"Nutrition and Dietary Deficiencies","concept":"food_nutrition","concept_label":"Food, n