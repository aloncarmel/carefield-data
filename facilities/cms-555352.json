isk.","category":"Gas, Vacuum, and Electrical Systems Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-k0346":{"code":"K-0346","title":"Follow proper procedures when the fire alarm was out of service for more than 4 hours.","category":"Smoke Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-k0354":{"code":"K-0354","title":"Follow proper procedures when the automatic sprinkler systems was out of service for more than 10 hours.","category":"Smoke Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-f0801":{"code":"F-0801","title":"Employ sufficient staff with the appropriate competencies and skills sets to carry out the functions of the food and nutrition service, including a qualified dietician.","category":"Nutrition and Dietary Deficiencies","concept":"food_nutrition","concept_label":"Food, nutrition & hydration"},"cms-f0911":{"code":"F-0911","title":"Ensure resident rooms hold no more than 4 residents; for new construction after November 28, 2016, rooms hold no more than 2 residents.","category":"Environmental Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-f0926":{"code":"F-0926","title":"Have policies on smoking.","category":"Environmental Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-f0550":{"code":"F-0550","title":"Honor the resident's right to a dignified existence, self-determination, communication, and to exercise his or her rights.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0580":{"code":"F-0580","title":"Immediately tell the resident, the resident's doctor, and a family member of situations (injury/decline/room, etc.)  that affect the resident.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept