0552","title":"Ensure that residents are fully informed and understand their health status, care and treatments.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0745":{"code":"F-0745","title":"Provide medically-related social services to help each resident achieve the highest possible quality of life.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0803":{"code":"F-0803","title":"Ensure menus must meet the nutritional needs of residents, be prepared in advance, be followed, be updated, be reviewed by dietician, and meet the needs of the resident.","category":"Nutrition and Dietary Deficiencies","concept":"food_nutrition","concept_label":"Food, nutrition & hydration"},"cms-k0712":{"code":"K-0712","title":"Have simulated fire drills held at unexpected times.","category":"Miscellaneous Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-k0321":{"code":"K-0321","title":"Ensure that special areas are constructed so that walls can resist fire for one hour or have an approved fire extinguishing system.","category":"Smoke Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-f0578":{"code":"F-0578","title":"Honor the resident's right to request, refuse, and/or discontinue treatment, to participate in or refuse to participate in experimental research, and to formulate an advance directive.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0806":{"code":"F-0806","title":"Ensure each resident receives and the facility provides food that accommodates resident allergies, intolerances, and preferences, as well as appealing options.","category":"Nutrition and Dietary Deficiencies","concept":"food_nutrition","concept_label":"Food, nutrition & hydration"},"cms-f0921":