ing & supervision"},"cms-f0801":{"code":"F-0801","title":"Employ sufficient staff with the appropriate competencies and skills sets to carry out the functions of the food and nutrition service, including a qualified dietician.","category":"Nutrition and Dietary Deficiencies","concept":"food_nutrition","concept_label":"Food, nutrition & hydration"},"cms-f0802":{"code":"F-0802","title":"Provide sufficient support personnel to safely and effectively carry out the functions of the food and nutrition service.","category":"Nutrition and Dietary Deficiencies","concept":"food_nutrition","concept_label":"Food, nutrition & hydration"},"cms-f0806":{"code":"F-0806","title":"Ensure each resident receives and the facility provides food that accommodates resident allergies, intolerances, and preferences, as well as appealing options.","category":"Nutrition and Dietary Deficiencies","concept":"food_nutrition","concept_label":"Food, nutrition & hydration"},"cms-f0809":{"code":"F-0809","title":"Ensure meals and snacks are served at times in accordance with resident’s needs, preferences, and requests.  Suitable and nourishing alternative meals and snacks must be provided for residents who want to eat at non-traditional times or outside of scheduled meal times.","category":"Nutrition and Dietary Deficiencies","concept":"food_nutrition","concept_label":"Food, nutrition & hydration"},"cms-f0812":{"code":"F-0812","title":"Procure food from sources approved or considered satisfactory and store, prepare, distribute and serve food in accordance with professional standards.","category":"Nutrition and Dietary Deficiencies","concept":"food_nutrition","concept_label":"Food, nutrition & hydration"},"cms-f0880":{"code":"F-0880","title":"Provide and implement an infection prevention and control program.","category":"Infection Control Deficiencies","concept":"infection_prevention","concept_label":"Infection prevention"},"cms-f0908":{"code":"F-0908","title":"Keep all essential equipment working safely.","category":"Environmental Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-f0921":{"code":"F-0921","title":"Make sure that the nursing home area is safe, easy to use, clean and comfortable for residents, staff and the public.","category":"Environmental Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-f0550":{"code":"F-0550","title":"Honor the resident's right to a dignified existence, self-determination, communication, and to exercise his or her rights.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0695":{"code":"F-0695","title":"Provide safe and appropriate respiratory care for a resident when needed.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0804":{"code":"F-0804","title":"Ensure food and drink is palatable, attractive, and at a safe and appetizing temperature.","category":"Nutrition and Dietary Deficiencies","concept":"food_nutrition","concept_label":"Food, nutrition & hydration"},"cms-f0582":{"code":"F-0582","title":"Give residents notice of Medicaid/Medicare coverage and potential liability for services not covered.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0625":{"code":"F-0625","title":"Notify the resident or the resident’s representative in writing how long the nursing home will hold the resident’s bed in cases of transfer to a hospital or therapeutic leave.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0692":{"code":"F-0692","title":"Provide enough food/fluids to maintain a resident's health.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0761":{"code":"F-0761","tit