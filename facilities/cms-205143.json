esident rights & abuse/neglect"},"cms-f0812":{"code":"F-0812","title":"Procure food from sources approved or considered satisfactory and store, prepare, distribute and serve food in accordance with professional standards.","category":"Nutrition and Dietary Deficiencies","concept":"food_nutrition","concept_label":"Food, nutrition & hydration"},"cms-f0880":{"code":"F-0880","title":"Provide and implement an infection prevention and control program.","category":"Infection Control Deficiencies","concept":"infection_prevention","concept_label":"Infection prevention"},"cms-f0635":{"code":"F-0635","title":"Provide doctor's orders for the resident's immediate care at the time the resident was admitted.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0644":{"code":"F-0644","title":"Coordinate assessments with the pre-admission screening and resident review program; and referring for services as needed.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0756":{"code":"F-0756","title":"Ensure a licensed pharmacist perform a monthly drug regimen review, including the medical chart, following irregularity reporting guidelines in developed policies and procedures.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0842":{"code":"F-0842","title":"Safeguard resident-identifiable information and/or maintain medical records on each resident that are in accordance with accepted professional standards.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0883":{"code":"F-0883","title":"Develop and implement policies and procedures for flu and pneumonia vaccinations.","category":"Infection Control Deficiencies","concept":"infection_prevention","concept_label":"Infection prevention"},"cms-f088