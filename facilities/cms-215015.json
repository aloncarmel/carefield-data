_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0610":{"code":"F-0610","title":"Respond appropriately to all alleged violations.","category":"Freedom from Abuse, Neglect, and Exploitation Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0641":{"code":"F-0641","title":"Ensure each resident receives an accurate assessment.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0740":{"code":"F-0740","title":"Ensure each resident must receive and the facility must provide necessary behavioral health care and services.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0761":{"code":"F-0761","title":"Ensure drugs and biologicals used in the facility are labeled in accordance with currently accepted professional principles; and all drugs and biologicals must be stored in locked compartments, separately locked, compartments for controlled drugs.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0658":{"code":"F-0658","title":"Ensure services provided by the nursing facility meet professional standards of quality.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0755":{"code":"F-0755","title":"Provide pharmaceutical services to meet the needs of each resident and employ or obtain the services of a licensed pharmacist.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0759":{"code":"F-0759","title":"Ensure medication error rates are not 5 percent or greater.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-e0004":{"code":"E-0004","title":"Develop and maintain an Emergency Preparedness Program (EP).","