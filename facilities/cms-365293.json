n advance directive.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0622":{"code":"F-0622","title":"Not transfer or discharge a resident without an adequate reason; and must provide documentation and convey specific information  when a resident is transferred or discharged.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0677":{"code":"F-0677","title":"Provide care and assistance to perform activities of daily living for any resident who is unable.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0698":{"code":"F-0698","title":"Provide safe, appropriate dialysis care/services for a resident who requires such services.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0755":{"code":"F-0755","title":"Provide pharmaceutical services to meet the needs of each resident and employ or obtain the services of a licensed pharmacist.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0758":{"code":"F-0758","title":"Implement gradual dose reductions(GDR) and non-pharmacological interventions, unless contraindicated, prior to initiating or instead of continuing psychotropic medication; and PRN orders for psychotropic medications are only used when the medication is necessary and PRN use is limited.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0800":{"code":"F-0800","title":"Provide each resident with a nourishing, palatable, well-balanced diet that meets his or her daily nutritional and special dietary needs.","category":"Nutrition and Dietary Deficiencies","concept":"food_nutrition","concept_label":"Food, nutrition & hydration"},"cms-f0842":{"code":"F-0842",