cept":"clinical_care","concept_label":"Clinical care"},"cms-f0880":{"code":"F-0880","title":"Provide and implement an infection prevention and control program.","category":"Infection Control Deficiencies","concept":"infection_prevention","concept_label":"Infection prevention"},"cms-f0604":{"code":"F-0604","title":"Ensure that each resident is free from the use of physical restraints, unless needed for medical treatment.","category":"Freedom from Abuse, Neglect, and Exploitation Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-k0712":{"code":"K-0712","title":"Have simulated fire drills held at unexpected times.","category":"Miscellaneous Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-k0761":{"code":"K-0761","title":"To conduct inspection, testing and maintenance of fire doors by qualified individuals.","category":"Miscellaneous Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-k0374":{"code":"K-0374","title":"Install smoke barrier doors that can resist smoke for at least 20 minutes.","category":"Smoke Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-f0688":{"code":"F-0688","title":"Provide appropriate care for a resident to maintain and/or improve range of motion (ROM), limited ROM and/or mobility, unless a decline is for a medical reason.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0758":{"code":"F-0758","title":"Implement gradual dose reductions(GDR) and non-pharmacological interventions, unless contraindicated, prior to initiating or instead of continuing psychotropic medication; and PRN orders for psychotropic medications are only used when the medication is necessary and PRN use is limited.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0803":{"code":"F-0803","title":"Ensure menus must meet the nutritional needs of residents, be prepared in advance, be followed, be updated, be reviewed by dietician, and meet the needs of the resident.","category":"Nutrition and Dietary Deficiencies","concept":"food_nutrition","concept_label":"Food, nutrition & hydration"},"cms-f0565":{"code":"F-0565","title":"Honor the resident's right to organize and participate in resident/family groups in the facility.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0574":{"code":"F-0574","title":"The resident has the right to receive notices in a format and a language he or she understands.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0576":{"code":"F-0576","title":"Ensure residents have reasonable access to and privacy in their use of communication methods.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0577":{"code":"F-0577","title":"Allow residents to easily view the nursing home's survey results and communicate with advocate agencies.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0585":{"code":"F-0585","title":"Honor the resident's right to voice grievances without discrimination or reprisal and the facility must establish a grievance policy and make prompt efforts to resolve grievances.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0684":{"code":"F-0684","title":"Provide appropriate treatment and care according to orders, resident’s preferences and goals.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0700":{"code":"F-0700","title":"Try different approaches before using a bed rail.  If a bed rail is needed, the facility must (1) assess a resident for safety risk; (2) review these risks and benefits with the resident/representative; (3) get informed consent; and (4) Correctly install and maintain the bed rail.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0812":{"code":"F-0812","title":"Procure food from sources approved or considered satisfactory and store, prepare, distribute and serve food in accordance with professional standards.","category":"Nutrition and Dietary Deficiencies","concept":"food_nutrition","concept_label":"Food, nutrition & hydration"},"cms-f0919":{"code":"F-0919","title":"Make sure that a working call system is available in each resident's  bathroom and bathing area.","category":"Environmental Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-f0550":{"code":"F-0550","title":"Honor the resident's right to a dignified existence, self-determination, communication, and to exercise his or her rights.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0554":{"code":"F-0554","title":"Allow residents to self-administer drugs if determined clinically appropriate.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0641":{"code":"F-0641","title":"Ensure each resident receives an accurate assessment.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0657":{"code":"F-0657","title":"Develop the complete care plan within 7 days of the comprehensive assessment; and prepared, reviewed, and revised by a team of health professionals.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"