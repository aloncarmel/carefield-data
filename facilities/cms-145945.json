ency_types":{"cms-f0689":{"code":"F-0689","title":"Ensure that a nursing home area is free from accident hazards and provides adequate supervision to prevent accidents.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0600":{"code":"F-0600","title":"Protect each resident from all types of abuse such as physical, mental, sexual abuse, physical punishment, and neglect by anybody.","category":"Freedom from Abuse, Neglect, and Exploitation Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0627":{"code":"F-0627","title":"Ensure the transfer/discharge meets the resident's needs/preferences and that the resident is prepared for a safe transfer/discharge.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0607":{"code":"F-0607","title":"Develop and implement policies and procedures to prevent abuse, neglect, and theft.","category":"Freedom from Abuse, Neglect, and Exploitation Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0610":{"code":"F-0610","title":"Respond appropriately to all alleged violations.","category":"Freedom from Abuse, Neglect, and Exploitation Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0657":{"code":"F-0657","title":"Develop the complete care plan within 7 days of the comprehensive assessment; and prepared, reviewed, and revised by a team of health professionals.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0690":{"code":"F-0690","title":"Provide appropriate care for residents who are continent or incontinent of bowel/bladder, appropriate catheter care,  and appropriate care  to prevent urinary tract infections.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0801":{"code":"F-0801","title":"Employ sufficient staff with the appropriate competencies and skills sets to carry out the functions of the food and nutrition service, including a qualified dietician.","category":"Nutrition and Dietary Deficiencies","concept":"food_nutrition","concept_label":"Food, nutrition & hydration"},"cms-f0812":{"code":"F-0812","title":"Procure food from sources approved or considered satisfactory and store, prepare, distribute and serve food in accordance with professional standards.","category":"Nutrition and Dietary Deficiencies","concept":"food_nutrition","concept_label":"Food, nutrition & hydration"},"cms-f0761":{"code":"F-0761","title":"Ensure drugs and biologicals used in the facility are labeled in accordance with currently accepted professional principles; and all drugs and biologicals must be stored in locked compartments, separately locked, compartments for controlled drugs.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0881":{"code":"F-0881","title":"Implement a program that monitors antibiotic use.","category":"Infection Control Deficiencies","concept":"infection_prevention","concept_label":"Infection prevention"},"cms-f0605":{"code":"F-0605","title":"Prevent the use of unnecessary psychotropic medications or use medications that may restrain a resident's ability to function.","category":"Freedom from Abuse, Neglect, and Exploitation Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0656":{"code":"F-0656","title":"Develop and implement a complete care plan that meets all the resident's needs, with timetables and actions that can be measured.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0726":{"code":"F-0726","title":"Ensure that nurses and nurse aides have the appropriate competencies to care for every resident in a way that maximizes each resident's well being.","category":"Nursing and Physician Services Deficiencies","concept":"staffing","concept_label":"Staffing & supervision"},"cms-f0554":{"code":"F-0554","title":"Allow residents to self-administer drugs if determined clinically appropriate.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0583":{"code":"F-0583","title":"Keep residents' personal and medical records private and confidential.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0641":{"code":"F-0641","title":"Ensure each resident receives an accurate assessment.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0659":{"code":"F-0659","title":"Provide care by qualified persons according to each resident's written plan of care.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0686":{"code":"F-0686","title":"Provide appropriate pressure ulcer care and prevent new ulcers from developing.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0692":{"code":"F-0692","title":"Provide enough food/fluids to maintain a resident's health.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0695":{"code":"F-0695","title":"Provide safe and appropriate respiratory care for a resident when needed.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0755":{"code":"F-0755","title":"Provide pharmaceutical services to meet the needs of each resident and employ or obtain the services of a licensed pharmacist.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0760":{"code":"F-0760","title":"Ensure that residents are free from significant medication errors.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0880":{"code":"F-0880","title":"Provide and implement an infection prevention and control program.","category":"Infection Control Deficiencies","concept":"infection_prevention","concept_label":"Infection prevention"},"cms-f0678":{"code":"F-0678","title":"Provide basic life support, including CPR, prior to the arrival of emergency medical personnel , subject to physician orders and the resident’s advance directives.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0882":{"code":"F-0882","title":"Designate a qualified infection preventionist to be responsible for the infection prevent and control program in the nursing home.","category":"Infection Control Deficiencies","concept":"infection_prevention","concept_label":"Infection prevention"},"cms-f0842":{"code":"F-0842","title":"Safeguard resident-identifiable information and/or maintain medical records on each resident that are in accordance with accepted professional standards.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0580":{"code":"F-0580","title":"Immediately tell the resident, the resident's doctor, and a family member of situations (injury/decline/room, etc.)  that affect the resident.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0658":{"code":"F-0658","title":"Ensure services provided by the nursing facility meet professional standards of quality.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0684":{"code":"F-0684","title":"Provide appropriate treatment and care according to orders, resident’s preferences and goals.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0809":{"code":"F-0809","title":"Ensure meals and snacks are served at times in accordance with resident’s needs, preferences, and requests.  Suitable and nourishing alternative meals and snacks must be provided for residents who want to eat at non-traditional times or outside of scheduled meal times.","category":"Nutrition and Dietary Deficiencies","concept":"food_nutrition","concept_label":"Food, nutrition & hydration"},"cms-f0609":{"code":"F-0609","title":"Timely report suspected abuse, neglect, or theft and report the results of the investigation to proper authorities.","category":"Freedom from Abuse, Neglect, and Exploitation Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0758":{"code":"F-0758","title":"Implement gradual dose reductions(GDR) and non-pharmacological interventions, unless contraindicated, prior to initiating or instead of continuing psychotropic medication; and PRN orders for psychotropic medications are only used when the medication is necessary and PRN use is limited.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0578":{"code":"F-0578","title":"Honor the resident's right to request, refuse, and/or discontinue treatment, to participate in or refuse to participate in experimental research, and to formulate an advance directive.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0550":{"code":"F-0550","title":"Honor the resident's right to a dignified existence, self-determination, communication, and to exercise his or her rights.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0803":{"code":"F-0803","title":"Ensure menus must meet the nutritional needs of residents, be prepared in advance, be followed, be updated, be reviewed by dietician, and meet the needs of the resident.","category":"Nutrition and Dietary Deficiencies","concept":"food_nutrition","concept_label":"Food, nutrition & hydration"},"cms-f0908":{"code":"F-0908","title":"Keep all essential equipment working safely.","category":"Environmental Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-f0943":{"code":"F-0943","title":"Give their staff education on dementia care, and what abuse, neglect, and exploitation are; and how to report abuse, neglect, and exploitation.","category":"Freedom from Abuse, Neglect, and Exploitation Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0677":{"code":"F-0677","title":"Provide care and assistance to perform activities of daily living for any resident who is unable.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0730":{"code":"F-0730","title":"Observe each nurse aide's job performance and give regular training.","category":"Nursing and Physician Services Deficiencies","concept":"staffing","concept_label":"Staffing & supervision"},"cms-f0883":{"code":"F-0883","title":"Develop and implement policies and procedures for flu and pneumonia vaccinations.","category":"Infection Control Deficiencies","concept":"infection_prevention","concept_label":"Infection prevention"},"cms-f0604":{"code":"F-0604","title":"Ensure that each resident is free from the use of physical restraints, unless needed for medical treatment.","category":"Freedom from Abuse, Neglect, and Exploitation Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0644":{"code":"F-0644","title":"Coordinate assessments with the pre-admission screening and resi