y Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0773":{"code":"F-0773","title":"Provide or obtain laboratory tests/services when ordered and promptly tell the ordering practitioner of the results.","category":"Administration Deficiencies","concept":"administration","concept_label":"Administration & records"},"cms-f0880":{"code":"F-0880","title":"Provide and implement an infection prevention and control program.","category":"Infection Control Deficiencies","concept":"infection_prevention","concept_label":"Infection prevention"},"cms-e0031":{"code":"E-0031","title":"Provide emergency officials' contact information.","category":"Emergency Preparedness Deficiencies","concept":"emergency_preparedness","concept_label":"Emergency preparedness"},"cms-k0918":{"code":"K-0918","title":"Have generator or other power source capable of supplying service within 10 seconds.","category":"Gas, Vacuum, and Electrical Systems Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-k0132":{"code":"K-0132","title":"Meet requirements for outpatient facilities located next to inpatient facilities separated by fire resistive construction.","category":"Construction Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-k0345":{"code":"K-0345","title":"Have approved installation, maintenance and testing program for fire alarm systems.","category":"Smoke Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-k0712":{"code":"K-0712","title":"Have simulated fire drills held at unexpected times.","category":"Miscellaneous Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-f0812":{"code":"F-0812","title":"Procure food from sources approved or considered satisfactory and store, prepare, distribute and serve food in accordance with professional standards.","category":"Nutrit