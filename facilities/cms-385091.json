e"},"cms-f0689":{"code":"F-0689","title":"Ensure that a nursing home area is free from accident hazards and provides adequate supervision to prevent accidents.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-k0111":{"code":"K-0111","title":"Satisfy building requirements after a repair, renovation, modification, or change of user/occupancy.","category":"Construction Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-k0712":{"code":"K-0712","title":"Have simulated fire drills held at unexpected times.","category":"Miscellaneous Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-f0600":{"code":"F-0600","title":"Protect each resident from all types of abuse such as physical, mental, sexual abuse, physical punishment, and neglect by anybody.","category":"Freedom from Abuse, Neglect, and Exploitation Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0609":{"code":"F-0609","title":"Timely report suspected abuse, neglect, or theft and report the results of the investigation to proper authorities.","category":"Freedom from Abuse, Neglect, and Exploitation Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0636":{"code":"F-0636","title":"Assess the resident completely in a timely manner  when first admitted, and then periodically, at least every 12 months.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0698":{"code":"F-0698","title":"Provide safe, appropriate dialysis care/services for a resident who requires such services.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0791":{"code":"F-0791","title":"Provide or obtain dental services for each resident.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0761":{"code":"F-0761","title":"Ensure drugs and biologicals used in the facility are labeled in accordance with currently accepted professional principles; and all drugs and biologicals must be stored in locked compartments, separately locked, compartments for controlled drugs.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0552":{"code":"F-0552","title":"Ensure that residents are fully informed and understand their health status, care and treatments.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0623":{"code":"F-0623","title":"Provide timely notification to the resident, and if applicable to the resident representative and ombudsman, before transfer or discharge, including appeal rights.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0625":{"code":"F-0625","title":"Notify the resident or the resident’s representative in writing how long the nursing home will hold the resident’s bed in cases of transfer to a hospital or therapeutic leave.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0755":{"code":"F-0755","title":"Provide pharmaceutical services to meet the needs of each resident and employ or obtain the services of a licensed pharmacist.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0756":{"code":"F-0756","title":"Ensure a licensed pharmacist perform a monthly drug regimen review, including the medical chart, following irregularity reporting guidelines in developed policies and procedures.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication manage