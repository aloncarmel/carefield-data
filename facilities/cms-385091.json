 program.","category":"Infection Control Deficiencies","concept":"infection_prevention","concept_label":"Infection prevention"},"cms-f0554":{"code":"F-0554","title":"Allow residents to self-administer drugs if determined clinically appropriate.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0578":{"code":"F-0578","title":"Honor the resident's right to request, refuse, and/or discontinue treatment, to participate in or refuse to participate in experimental research, and to formulate an advance directive.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0582":{"code":"F-0582","title":"Give residents notice of Medicaid/Medicare coverage and potential liability for services not covered.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0695":{"code":"F-0695","title":"Provide safe and appropriate respiratory care for a resident when needed.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0730":{"code":"F-0730","title":"Observe each nurse aide's job performance and give regular training.","category":"Nursing and Physician Services Deficiencies","concept":"staffing","concept_label":"Staffing & supervision"},"cms-f0757":{"code":"F-0757","title":"Ensure each resident’s drug regimen must be free from unnecessary drugs.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0847":{"code":"F-0847","title":"Inform resident or representatives choice to enter into binding arbitration agreement and right to refuse.","category":"Administration Deficiencies","concept":"administration","concept_label":"Administration & records"},"cms-f0947":{"code":"F-0947","title":"Ensure nurse aides have the skills they need to care for res