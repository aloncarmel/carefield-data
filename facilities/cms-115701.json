"F-0554","title":"Allow residents to self-administer drugs if determined clinically appropriate.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0558":{"code":"F-0558","title":"Reasonably accommodate the needs and preferences of each resident.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0628":{"code":"F-0628","title":"Provide the required documentation or notification related to the resident's needs, appeal rights, or bed-hold policies.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0656":{"code":"F-0656","title":"Develop and implement a complete care plan that meets all the resident's needs, with timetables and actions that can be measured.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0757":{"code":"F-0757","title":"Ensure each resident’s drug regimen must be free from unnecessary drugs.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0759":{"code":"F-0759","title":"Ensure medication error rates are not 5 percent or greater.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-e0031":{"code":"E-0031","title":"Provide emergency officials' contact information.","category":"Emergency Preparedness Deficiencies","concept":"emergency_preparedness","concept_label":"Emergency preparedness"},"cms-k0211":{"code":"K-0211","title":"Keep aisles, corridors, and exits free of obstruction in case of emergency.","category":"Egress Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-k0372":{"code":"K-0372","title":"Ensure smoke barriers are constructed to a 1 hour fire resistance rating."