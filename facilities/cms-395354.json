king safely.","category":"Environmental Deficiencies","concept":"environment_life_safety","concept_label":"Environment & life safety"},"cms-f0568":{"code":"F-0568","title":"Properly hold, secure, and manage each resident's personal money which is deposited with the nursing home.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0660":{"code":"F-0660","title":"Plan the resident's discharge to meet the resident's goals and needs.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0676":{"code":"F-0676","title":"Ensure residents do not lose the ability to perform activities of daily living unless there is a medical reason.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0758":{"code":"F-0758","title":"Implement gradual dose reductions(GDR) and non-pharmacological interventions, unless contraindicated, prior to initiating or instead of continuing psychotropic medication; and PRN orders for psychotropic medications are only used when the medication is necessary and PRN use is limited.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0760":{"code":"F-0760","title":"Ensure that residents are free from significant medication errors.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0880":{"code":"F-0880","title":"Provide and implement an infection prevention and control program.","category":"Infection Control Deficiencies","concept":"infection_prevention","concept_label":"Infection prevention"},"cms-f0881":{"code":"F-0881","title":"Implement a program that monitors antibiotic use.","category":"Infection Control Deficiencies","concept":"infection_prevention","concept_label":"Infection prevention"},"cms-f0925":{"code":"F-0925",