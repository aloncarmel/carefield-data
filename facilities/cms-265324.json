le":"Honor the resident's right to a safe, clean, comfortable and homelike environment, including but not limited to receiving treatment and supports for daily living safely.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0628":{"code":"F-0628","title":"Provide the required documentation or notification related to the resident's needs, appeal rights, or bed-hold policies.","category":"Resident Rights Deficiencies","concept":"resident_rights","concept_label":"Resident rights & abuse/neglect"},"cms-f0641":{"code":"F-0641","title":"Ensure each resident receives an accurate assessment.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0656":{"code":"F-0656","title":"Develop and implement a complete care plan that meets all the resident's needs, with timetables and actions that can be measured.","category":"Resident Assessment and Care Planning Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0695":{"code":"F-0695","title":"Provide safe and appropriate respiratory care for a resident when needed.","category":"Quality of Life and Care Deficiencies","concept":"clinical_care","concept_label":"Clinical care"},"cms-f0755":{"code":"F-0755","title":"Provide pharmaceutical services to meet the needs of each resident and employ or obtain the services of a licensed pharmacist.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0761":{"code":"F-0761","title":"Ensure drugs and biologicals used in the facility are labeled in accordance with currently accepted professional principles; and all drugs and biologicals must be stored in locked compartments, separately locked, compartments for controlled drugs.","category":"Pharmacy Service Deficiencies","concept":"medication","concept_label":"Medication management"},"cms-f0880":{"code":"F-0